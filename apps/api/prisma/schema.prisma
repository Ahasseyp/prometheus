// Prisma schema for Prometheus.
// See CONTEXT.md for domain language and docs/adr/ for architectural decisions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  memberships HouseholdMembership[]
  sessions    Session[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Household {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  reportingCurrency String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  memberships  HouseholdMembership[]
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
}

model Account {
  id          String      @id @default(uuid()) @db.Uuid
  householdId String      @db.Uuid
  name        String
  type        AccountType
  currency    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([householdId])
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  INVESTMENT
  LOAN
}

// A household may have at most one OWNER, and in v1 a user may be the OWNER of
// at most one household. Those constraints are enforced by partial unique
// indexes in the migration because Prisma 5.22 does not support partial indexes
// in the schema. The application layer ensures a household is created with
// exactly one OWNER.
model HouseholdMembership {
  id          String                  @id @default(uuid()) @db.Uuid
  householdId String                  @db.Uuid
  userId      String                  @db.Uuid
  role        HouseholdMembershipRole
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @default(now()) @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([householdId, userId])
  @@index([userId])
}

enum HouseholdMembershipRole {
  OWNER
  MEMBER
}

// A Category with a parentId is a Subcategory; nesting beyond one level is
// rejected by the application layer (CONTEXT.md). System Categories
// (isSystem) are seeded per Household and can be renamed but never deleted.
model Category {
  id          String          @id @default(uuid()) @db.Uuid
  householdId String          @db.Uuid
  name        String
  type        TransactionType
  isSystem    Boolean         @default(false)
  parentId    String?         @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  parent       Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]    @relation("CategoryHierarchy")
  transactions Transaction[]

  @@index([householdId])
  @@index([parentId])
}

// The amount is stored in minor units of the Account's currency and is
// always positive; the type carries the direction (issue #24). There is no
// currency column: a Transaction uses its Account's currency (ADR-0002).
model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  householdId String          @db.Uuid
  accountId   String          @db.Uuid
  categoryId  String          @db.Uuid
  type        TransactionType
  amount      BigInt
  date        DateTime
  description String          @default("")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([householdId])
  @@index([accountId])
  @@index([householdId, date])
}

enum TransactionType {
  INCOME
  EXPENSE
}
