// Prisma schema for Prometheus.
// See CONTEXT.md for domain language and docs/adr/ for architectural decisions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  memberships HouseholdMembership[]
  sessions    Session[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Household {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  reportingCurrency String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  memberships  HouseholdMembership[]
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  transfers    Transfer[]
}

model ExchangeRate {
  id            String   @id @default(uuid()) @db.Uuid
  baseCurrency  String
  quoteCurrency String
  date          DateTime @db.Date
  rate          Decimal  @db.Decimal(19, 8)
  provider      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([baseCurrency, quoteCurrency, date])
}

model Account {
  id          String      @id @default(uuid()) @db.Uuid
  householdId String      @db.Uuid
  name        String
  type        AccountType
  currency    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([householdId])
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  INVESTMENT
  LOAN
}

// A household may have at most one OWNER, and in v1 a user may be the OWNER of
// at most one household. Those constraints are enforced by partial unique
// indexes in the migration because Prisma 5.22 does not support partial indexes
// in the schema. The application layer ensures a household is created with
// exactly one OWNER.
model HouseholdMembership {
  id          String                  @id @default(uuid()) @db.Uuid
  householdId String                  @db.Uuid
  userId      String                  @db.Uuid
  role        HouseholdMembershipRole
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @default(now()) @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([householdId, userId])
  @@index([userId])
}

enum HouseholdMembershipRole {
  OWNER
  MEMBER
}

// A Category with a parentId is a Subcategory; nesting beyond one level is
// rejected by the application layer (CONTEXT.md). System Categories
// (isSystem) are seeded per Household and can be renamed but never deleted.
model Category {
  id          String          @id @default(uuid()) @db.Uuid
  householdId String          @db.Uuid
  name        String
  type        TransactionType
  isSystem    Boolean         @default(false)
  parentId    String?         @db.Uuid
  // Lucide icon key (kebab-case), chosen by the Household for Custom
  // Categories and seeded for System Categories. Null means the default
  // tag icon.
  icon        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  parent       Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]    @relation("CategoryHierarchy")
  transactions Transaction[]

  @@index([householdId])
  @@index([parentId])
}

// The amount is stored in minor units of the Account's currency and is
// always positive; the type carries the direction (issue #24). Reporting
// Currency and Exchange Rate snapshot the historical conversion (ADR-0002).
// Transfer Transactions (issue #26) have no Category; the Transfer record
// links the source (expense) and destination (income) pair.
model Transaction {
  id                     String          @id @default(uuid()) @db.Uuid
  householdId            String          @db.Uuid
  accountId              String          @db.Uuid
  categoryId             String?         @db.Uuid
  type                   TransactionType
  amount                 BigInt
  date                   DateTime
  description            String          @default("")
  reportingCurrency      String?
  exchangeRate           Decimal?        @db.Decimal(19, 8)
  exchangeRateOverridden Boolean         @default(false)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @default(now()) @updatedAt

  household             Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account               Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category              Category?   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transferSource        Transfer[]  @relation("TransferSource")
  transferDestination   Transfer[]  @relation("TransferDestination")

  @@index([householdId])
  @@index([accountId])
  @@index([householdId, date])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

// A Transfer is a first-class record linking one source Transaction and one
// destination Transaction; both are written or removed in one database
// transaction (issue #26). Cross-currency Transfers store the direct
// source-to-destination Exchange Rate; same-currency Transfers leave it null.
model Transfer {
  id                       String   @id @default(uuid()) @db.Uuid
  householdId              String   @db.Uuid
  sourceTransactionId      String   @unique @db.Uuid
  destinationTransactionId String   @unique @db.Uuid
  exchangeRate             Decimal? @db.Decimal(19, 8)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt

  household                Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  sourceTransaction        Transaction @relation("TransferSource", fields: [sourceTransactionId], references: [id], onDelete: Cascade)
  destinationTransaction   Transaction @relation("TransferDestination", fields: [destinationTransactionId], references: [id], onDelete: Cascade)

  @@index([householdId])
}
